# The ANB demonstration build's environment. Copy to .env.anb and edit.
#
# Everything here is namespaced away from the accepted 5328/8328 retail
# presentation: its own database, its own uploads and logs, and its own ports.
# The book itself is shared with the retail build's paths on purpose — the two
# are different CHECKOUTS of this repository rather than two installations in
# one, so each worktree has its own data/retail.
#
# .env.anb itself is git-ignored. Do not commit it.

DATABASE_URL=postgresql+psycopg://USER@HOST:PORT/creditprobe_anb

DATA_ANALYTICS_DIR=data/retail/analytics
DATA_CURATED_DIR=data/retail/curated
METADATA_DIR=metadata/retail
UPLOAD_DIR=var/anb/uploads
LOG_DIR=var/anb/logs

# The ANB frontend's origin. Without it the page loads, every API check passes
# from the shell, and the browser quietly shows 'Backend offline'.
CORS_ORIGINS=http://localhost:5330,http://127.0.0.1:5330

# Must use the SAME hostname the browser opens. The session cookie is host-only
# and SameSite=Lax: a page on localhost calling 127.0.0.1 is cross-site, the
# cookie is withheld, and every call answers 401.
NEXT_PUBLIC_API_URL=http://localhost:8330

API_PORT=8330
PORT=5330
CREDITPROBE_PRODUCT_PROFILE=retail
NEXT_PUBLIC_PRODUCT_PROFILE=retail
