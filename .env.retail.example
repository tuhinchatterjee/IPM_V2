# The retail installation's environment. Copy to .env.retail and edit.
#
# Everything here is namespaced away from the source demo: its own database, its
# own lake, its own catalogue, its own uploads and logs, and its own ports. The
# retail build commands refuse any target that is not marked as retail, so a
# half-edited copy of this file fails loudly rather than overwriting a frozen
# presentation.
#
# .env.retail itself is git-ignored. Do not commit it.

DATABASE_URL=postgresql+psycopg://USER@HOST:PORT/creditprobe_retail

DATA_ANALYTICS_DIR=data/retail/analytics
DATA_CURATED_DIR=data/retail/curated
METADATA_DIR=metadata/retail
UPLOAD_DIR=var/retail/uploads
LOG_DIR=var/retail/logs

# The retail frontend's origin. The default allows port 3000, which is the
# SOURCE demo's port: without this the retail page loads, every API check
# passes from the shell, and the browser quietly shows 'Backend offline'.
CORS_ORIGINS=http://localhost:5328,http://127.0.0.1:5328

# Must use the SAME hostname the browser opens. The session cookie is
# host-only and SameSite=Lax: a page on localhost calling 127.0.0.1 is
# cross-site, the cookie is withheld, and every call answers 401.
NEXT_PUBLIC_API_URL=http://localhost:8328

API_PORT=8328
PORT=5328
CREDITPROBE_PRODUCT_PROFILE=retail
NEXT_PUBLIC_PRODUCT_PROFILE=retail
