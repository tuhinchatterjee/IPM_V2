# The ten-journeys retail build's environment (CP-RA-V2).
#
# Copy to .env.anb2 and edit. .env.anb2 itself is git-ignored by the existing
# `.env.*` rule and must never be committed.
#
# Everything here is namespaced away from the three builds that are somebody's
# presentation: its own database, its own uploads and logs, and its own ports.
#
#   5328 / 8328   the frozen retail presentation      — untouched
#   5330 / 8330   the accepted ANB demonstration      — untouched
#   5332 / 8332   the Agentic Project Planner UAT     — untouched
#   5334 / 8334   THIS build
#
# THE DATABASE IS THE SETTING THAT MATTERS MOST.
#
# It must NOT be the accepted demonstration's. Rebuilding this build's data,
# running its migrations or replaying its portfolio review all write to it, and
# pointing it at creditprobe_retail would do that to a demonstration somebody
# is about to give. The launcher refuses to start if it recognises that name.
#
#     createdb creditprobe_anb_v2
#     .venv/bin/alembic upgrade head
DATABASE_URL=postgresql+psycopg://USER@HOST:PORT/creditprobe_anb_v2

# The book and the catalogue are SHARED with the other retail builds' paths on
# purpose: they are different CHECKOUTS of this repository rather than two
# installations in one, so each worktree has its own data/retail.
DATA_ANALYTICS_DIR=data/retail/analytics
DATA_CURATED_DIR=data/retail/curated
METADATA_DIR=metadata/retail

UPLOAD_DIR=var/anb2/uploads
LOG_DIR=var/anb2/logs

# This build's own origin. Without it the page loads, every API check passes
# from the shell, and the browser quietly shows 'Backend offline'.
CORS_ORIGINS=http://localhost:5334,http://127.0.0.1:5334

# Must use the SAME hostname the browser opens. The session cookie is host-only
# and SameSite=Lax: a page on localhost calling 127.0.0.1 is cross-site, the
# cookie is withheld, and every call answers 401.
NEXT_PUBLIC_API_URL=http://localhost:8334

API_PORT=8334
PORT=5334
CREDITPROBE_PRODUCT_PROFILE=retail
NEXT_PUBLIC_PRODUCT_PROFILE=retail
