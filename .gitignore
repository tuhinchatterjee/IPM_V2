# ---- secrets & local config ----
.env
.claude/settings.local.json

# ---- python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---- runtime data & logs ----
logs/
# Brain packages this installation built or received. Bytes, not source:
# an exported Brain Pack is a build artefact of whatever was approved on the
# day, and a quarantined upload is somebody else's package that this
# repository has no business carrying.
var/
uploads/
backups/
# Data Hub runtime artifacts (user uploads, staged/activated workbooks)
Uploaded_Portfolio_Dataset.xlsx
Staged_Portfolio_Dataset.xlsx

# ---- large source artifacts (not needed at runtime) ----
# Raw IMF WEO export; the compacted Macro_GCC_Compact.xlsx is what the app loads.
dataset_*IMF*.xlsx
# Source presentation deck (not used by the app).
*.pptx

# ---- IDE / OS ----
.vscode/
.idea/
Thumbs.db
.DS_Store

# --- Phase 1 additions ---
.venv/
node_modules/
frontend/.next/
frontend/out/
frontend/node_modules/
# Generated analytical layers — rebuilt from data/raw with scripts/build_data_lake.py.
# data/raw IS committed (it is the source of truth for the demo).
data/curated/*.parquet
data/analytics/
# The Cockpit Agentic V3 release lake. Deterministically rebuilt from one seed
# by scripts/build_cockpit_agentic_v3.py, so the bytes are a build artefact and
# the script is the source of truth. Its manifest, integrity report and
# coverage profile ARE committed, under docs/cockpit_agentic_v3/evidence.
data/cockpit_agentic_v3/
metadata/catalog.json

# ---- intelligence release ----
# Produced by `python -m intelligence_factory.certify --certify` at release
# time and copied into the image. A build artefact, not source: committing one
# would let a stale manifest certify code it never ran against.
intelligence_release/

# Generated workbooks. Both exports write to a browser download or a caller's
# buffer, never into the repository — but a workbook saved into the tree while
# debugging would carry a full analytical population with it, so the pattern is
# ignored rather than trusted to habit. §63.
CreditProbe_*.xlsx
CreditProbe_*.xlsx.*

# The retail scorecard universe is generated, not committed. 817k rows of
# Parquet belong in a build step, not in git history.
data/analytics/retail_application_scorecard_*/
data/analytics/retail_behavioral_scorecard_*/
data/scorecard/
data/cockpit_v4/
# The V4 analytical lake. Generated, deterministic and large: both Saudi
# domain releases are rebuilt byte-identically from their seeded generators
# by scripts/cockpit_v4/seed_domains.py, so committing sixty thousand rows of
# parquet would version an artefact the source already determines.
data/cockpit_v4_lake/
.cockpit_v4_runtime/

# A stray directory literally named "sqlite:" appears when a suite outside the
# Cockpit passes a DSN where a path was expected. Ignored so a test run cannot
# commit one; it is not produced by any Cockpit code path.
sqlite:/

# The What-If candidate's isolated environment. Built from
# requirements-whatif.txt by the candidate launcher; never the accepted
# application's interpreter, and never committed.
.venv-whatif/

# Trained emulator binaries. Regenerated by
# scripts/whatif/train_emulator.py, which reproduces them to the digit from
# fixed seeds and pinned versions -- so the 10 MB of pickles are a build
# output, not a source. Their SHA-256 hashes, the blend weights, the gate
# outcomes and the whole model card as data ARE committed, in blend.json and
# model_metric.json beside them.
artifacts/whatif/*/*.pkl
