# IPM Tool — environment configuration template.
# Copy to `.env` for local development:  cp .env.example .env
# In production these are injected as service env vars (NSSM), NOT read from a file.
# NEVER commit a real .env — it is git-ignored.

# ---- runtime ----
ENV=dev                     # dev | prod
HOST=127.0.0.1              # use 0.0.0.0 to serve the LAN in prod
PORT=8050

# ---- AI backends ----
# Rotate this in the Anthropic console; treat any previously-committed key as compromised.
ANTHROPIC_API_KEY=sk-ant-your-key-here
OLLAMA_BASE_URL=http://localhost:11434

# ---- paths & limits ----
LOG_DIR=logs
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# ---- database (Phase 2 — PostgreSQL) ----
# DATABASE_URL=postgresql+psycopg://ipm_app:CHANGE_ME@localhost:5432/ipm

# ---- auth (Phase 3 — Flask sessions) ----
# Generate once with:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=replace-with-a-long-random-hex-string

# ---- Docker ----
# Two ways to run in Docker (docs/deploy.md §11):
#
# 1. scripts\app-start.ps1 — app in a container, using the PostgreSQL already
#    installed on this PC. Uses DATABASE_URL above, rewriting localhost to
#    host.docker.internal (inside a container, localhost is the container).
#    Nothing extra to configure.
#
# 2. docker compose up -d — app AND its own PostgreSQL, fully self-contained.
#    This ignores DATABASE_URL above and needs the password below. SECRET_KEY is
#    also required: without it, everyone is logged out on every restart.
# POSTGRES_PASSWORD=choose-a-password
