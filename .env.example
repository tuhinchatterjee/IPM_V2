# =============================================================================
# IPM — configuration template
# =============================================================================
#
# HOW TO USE THIS FILE
#
#   1. Make a copy of it named exactly ".env"   (Mac/Linux: cp .env.example .env
#                                                Windows:   copy .env.example .env)
#   2. Change the values marked "CHANGE THIS".
#   3. Never commit your .env file. It is already excluded from git.
#
# Everything below has a sensible default for local development, so IPM will
# start even if you only set POSTGRES_PASSWORD and SECRET_KEY.
#
# RUNNING IN DOCKER? You do not need this file at all.
#
#   `docker compose up --build` carries development defaults for everything and
#   works on a fresh clone with no .env. If you do create one, Compose will use
#   your POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB and build the container
#   DATABASE_URL from them — it deliberately ignores the DATABASE_URL below,
#   because inside a container "localhost" means the container itself and the
#   database is reached at the service name `db`.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DATABASE  (PostgreSQL)
# -----------------------------------------------------------------------------
# This is the "filing cabinet" — users, projects, chats, analysis runs, traces,
# and the Engine Builder / Data Builder definitions.
#
# You do NOT need to install PostgreSQL. `docker compose up -d` starts it for
# you using the settings below.

# CHANGE THIS — any password you like for your local database. It only protects
# the database running on your own machine.
POSTGRES_PASSWORD=change_me_local_dev_password

POSTGRES_USER=ipm_app
POSTGRES_DB=ipm
POSTGRES_PORT=5432

# How the application connects. If you changed the values above, change the
# matching parts here too. The password must match POSTGRES_PASSWORD exactly.
DATABASE_URL=postgresql+psycopg://ipm_app:change_me_local_dev_password@localhost:5432/ipm


# -----------------------------------------------------------------------------
# 2. SECURITY
# -----------------------------------------------------------------------------
# Signs login sessions. If this is empty, everyone is logged out every time the
# server restarts.
#
# CHANGE THIS — generate a value by running:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Whether signing in is compulsory. TRUE by default, and the only reason to
# turn it off is a throwaway local session where nobody has seeded an account.
#
# With it on, the API refuses an unauthenticated request rather than treating
# the caller as an Analyst, and the interface shows the login screen. The four
# demonstration accounts are created on first start — see the README for the
# usernames and the shared password.
REQUIRE_LOGIN=true


# -----------------------------------------------------------------------------
# 3. AI MODEL  (used only for planning and narrative — never for calculations)
# -----------------------------------------------------------------------------
# The language model interprets your question and writes the explanation. It
# never does the arithmetic; the IPM Engine does that. See docs/PRODUCT_SPEC.md.
#
# Leave blank for now if you do not have a key — Phase 1 does not call any model.
# Get one from https://console.anthropic.com
# Which model orchestrates Ask CreditProbe. Set AI_PROVIDER=offline to force
# LIMITED OFFLINE MODE even when a key is present.
AI_PROVIDER=anthropic
# Optional. Empty uses the provider's pinned default model.
AI_MODEL=
ANTHROPIC_API_KEY=

# Optional: one model per job. CreditProbe asks a model five different things
# and they are not the same difficulty, so each can be configured separately.
# Anything left blank inherits AI_MODEL, and AI_MODEL blank uses the provider's
# own pinned default. A model id here that the provider does not serve is
# reported in Settings rather than silently replaced — an answer from a
# different model than the one certified is an answer with no certification.
#
#   ROUTER           what kind of request this is. Short and structured.
#   PLANNER          an ordinary request as a governed plan.
#   COMPLEX_PLANNER  the hard ones — broad investigations, decompositions,
#                    multi-domain forensics. Where an error costs most.
#   INTERPRETATION   what a computed result means, adding no figure to it.
#   CRITIC           repairing a plan the validator rejected.
#   TRANSLATION      optional, and unused until Arabic is implemented.
#
# COMPLEX_PLANNER falls back to AI_PLANNER_MODEL before AI_MODEL, so a
# deployment configured before the two were split keeps working unchanged.
AI_ROUTER_MODEL=
AI_PLANNER_MODEL=
AI_COMPLEX_PLANNER_MODEL=
AI_INTERPRETATION_MODEL=
AI_CRITIC_MODEL=
AI_TRANSLATION_MODEL=

# Optional reasoning effort per role, where the provider supports it:
# low | medium | high. Blank leaves it to the provider.
AI_ROUTER_EFFORT=
AI_PLANNER_EFFORT=
AI_COMPLEX_PLANNER_EFFORT=
AI_INTERPRETATION_EFFORT=
AI_CRITIC_EFFORT=
AI_TRANSLATION_EFFORT=

# A recommended starting point, subject to what your account can serve and to
# your own evaluation. These are NOT defaults and nothing in the code assumes
# them — a model id lives in configuration and only in configuration:
#
#   AI_ROUTER_MODEL=claude-sonnet-5
#   AI_PLANNER_MODEL=claude-sonnet-5
#   AI_COMPLEX_PLANNER_MODEL=claude-opus-5
#   AI_CRITIC_MODEL=claude-opus-5
#   AI_INTERPRETATION_MODEL=claude-sonnet-5

# What to do when the complex planner is configured but cannot be served —
# rate limited, unavailable, or an id the provider does not list. CreditProbe
# never silently answers with a weaker model, so this chooses between three
# honest outcomes:
#
#   FAIL_SAFE             say the request needs the complex model and stop.
#   ROUTINE_WITH_WARNING  answer with the routine planner at its highest
#                         supported effort, validate more strictly, and say
#                         on screen that the route was degraded.
#   QUEUE_FOR_REVIEW      raise a review item and do not answer now.
#
# Blank means FAIL_SAFE. Demo Safe Mode forces FAIL_SAFE whatever is set here.
AI_COMPLEX_UNAVAILABLE_POLICY=

# Client-demo safe mode. When on, CreditProbe routes anything ambiguous to the
# complex planning model, runs every check, and refuses to show an answer it
# cannot fully guarantee — it asks instead. Off for ordinary use.
DEMO_SAFE_MODE=false

# Optional: a locally-running model via Ollama, as an alternative to a hosted API.
OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------------------
# 4. RUNTIME
# -----------------------------------------------------------------------------
ENV=dev                          # dev | prod

# The backend API (FastAPI).
API_HOST=127.0.0.1
API_PORT=8000

# Which web addresses the browser is allowed to call the API from. The Next.js
# frontend runs on port 3000 in development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The frontend's address for the backend, when the frontend runs directly on
# your machine. Must match API_HOST/API_PORT above.
#
# In Docker this is deliberately left EMPTY (set in docker-compose.yml). An
# empty value makes the browser call the page's own address, and the Next.js
# server forwards it to the backend container — so there is only ever one
# address for the browser and no cross-origin request to configure.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Which port the interface is published on. Only used by Docker Compose.
WEB_PORT=3000


# -----------------------------------------------------------------------------
# 5. DATA LOCATIONS
# -----------------------------------------------------------------------------
# The three analytical layers (see docs/ARCHITECTURE.md §4.2). The defaults are
# correct for a normal checkout; change them only if you keep data elsewhere.
#
#   raw       original files exactly as received — never modified
#   curated   mapped to governed IPM field names, typed and validated
#   analytics business-ready Parquet, read by DuckDB through the Data Access Layer
DATA_RAW_DIR=data/raw
DATA_CURATED_DIR=data/curated
DATA_ANALYTICS_DIR=data/analytics

# Where the governed data catalogue (the Data Dictionary) is written.
METADATA_DIR=metadata

LOG_DIR=logs
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25


# -----------------------------------------------------------------------------
# 6. OPTIONAL — database browser
# -----------------------------------------------------------------------------
# Only used if you run:  docker compose --profile tools up -d
# Then open http://localhost:5050
PGADMIN_EMAIL=admin@ipm.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050


# -----------------------------------------------------------------------------
# 7. LEGACY (the original Dash application, preserved under legacy/dash_app/)
# -----------------------------------------------------------------------------
# Only needed if you run the old Dash app for reference. Not required for IPM.
HOST=127.0.0.1
PORT=8050
