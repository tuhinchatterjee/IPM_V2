# The candidate retail Cockpit, alongside the retail installation.
# Copy to .env.retail-candidate and adjust. Never committed with real values.

# --- which book the Cockpit reads -------------------------------------------
# The release projected from the published Cockpit Data domain. Produced by
# scripts/retail_cockpit/publish_release.py, which reads the retail lake
# read-only and writes only into the Cockpit lake.
COCKPIT_V4_RETAIL_RELEASE_ID=cockpitdata-r1.2.0-c1.0.0-s20260910-p4

# --- the candidate's own runtime --------------------------------------------
# State, artifacts, logs, pids and the session spill directory all live here.
COCKPIT_V4_RUNTIME_DIR=var/retail-cockpit-candidate/runtime

# --- how much memory one session may hold ------------------------------------
# PROVISIONAL. Chosen from docs/retail_cockpit/SESSION_MEMORY.md on a 16 GB
# Linux container with nothing else running: the lowest value in the approved
# set that materially reduces spilling (-91%, 62 MiB left), at 3,063 MiB peak
# RSS for this process.
#
# Confirm it on the machine that will run the demo before cutover -- that
# machine also carries the retail API, a Next dev server and a browser, and
# that is what "without unsafe process memory pressure" is about. Re-run:
#   .venv/bin/python scripts/retail_cockpit/benchmark_session.py
#
# Unset, the engine uses its own 1536MB, which on this book spills 711 MiB and
# takes 45 s to open. 3584MB is where spilling stops entirely, for 227 MiB more.
COCKPIT_V4_SQL_MEMORY_LIMIT=3072MB

# Where a session spills. Defaults to <COCKPIT_V4_RUNTIME_DIR>/duckdb-temp and
# is REFUSED if it resolves outside the runtime directory.
# COCKPIT_V4_SQL_TEMP_DIR=

# --- the provider ------------------------------------------------------------
# Names only. The credential is never written here; it is read from the
# environment the launcher inherits.
# AI_COCKPIT_REASONING_MODEL=
# COCKPIT_ANTHROPIC_API_KEY=
COCKPIT_V4_PRICE_CARD=config/cockpit_v4/price_card.json
